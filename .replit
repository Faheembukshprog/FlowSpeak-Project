modules = ["python-3.12", "nodejs-20", "web", "dotnet-7.0", "dotnet-10.0"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd flowspeak-ui && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PATH=\"/nix/store/bjzmfa360s8f3n4xqlnkamy13fkywb2x-dotnet-sdk-10.0.101/bin:$PATH\" && cd src/FlowSpeak.Api && dotnet run --no-build --urls='http://localhost:3001'"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

[userenv.shared]
JWT_SECRET = "CHANGE-ME-FlowSpeak-256bit-Secret-Key!!"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "export PATH=\"/nix/store/bjzmfa360s8f3n4xqlnkamy13fkywb2x-dotnet-sdk-10.0.101/bin:$PATH\" && cd src/FlowSpeak.Api && dotnet run --no-build -c Release --urls='http://0.0.0.0:3001'"]
build = ["bash", "-c", "export PATH=\"/nix/store/bjzmfa360s8f3n4xqlnkamy13fkywb2x-dotnet-sdk-10.0.101/bin:$PATH\" && cd flowspeak-ui && npm install && npm run build && cp -r dist ../src/FlowSpeak.Api/wwwroot && cd ../src/FlowSpeak.Api && dotnet build -c Release"]
