# ==============================================================================
# FLOWSPEAK PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env before starting containers:
#   cp .env.production.example .env
#
# DO NOT COMMIT THE COMPLETED .ENV FILE TO GIT.
# ==============================================================================

# Database Root Password (SQL Server 'sa' account)
# Ensure this password meets standard complexity requirements:
# At least 8 characters, containing uppercase, lowercase, numbers, and/or special symbols.
MSSQL_SA_PASSWORD=ChangeThisToAStrongSecretPassword2026!

# JWT Token Secret Key
# Must be a cryptographically strong, random string at least 256 bits (32 bytes) long.
JWT_SECRET=YourSuperLongAndSecureProductionJwtSecretKeyOfAtLeast32CharactersLong!

# Groq API Token
# Generate a secure API Token from your Groq console (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_actual_production_groq_api_token_here
