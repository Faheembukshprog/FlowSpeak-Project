{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_SQL_SERVER_CONNECTION_STRING_HERE"
  },
  "GROQ_API_KEY": "YOUR_GROQ_API_KEY_HERE",
  "JWT_SECRET": "YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS",
  "Jwt": {
    "Issuer": "FlowSpeak.Api",
    "Audience": "FlowSpeak.Client"
  },
  // These are for initial admin seeding in development or first run in production
  "PROD_ADMIN_USERNAME": "initialadmin", 
  "PROD_ADMIN_PASSWORD": "secure_password_for_initial_admin"
}